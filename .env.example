# Database: Postgres (Neon / RDS) or a local SQLite file for development
DATABASE_URL=file:./tao-website.db
# Payload secret (any long random string)
PAYLOAD_SECRET=change-me
# Public site URL (metadata, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Uploads: Vercel Blob (optional) - otherwise local disk (media/, documents/) or S3-compatible storage (AWS_* vars)
# BLOB_READ_WRITE_TOKEN=
